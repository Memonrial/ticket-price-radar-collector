{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticket-price-radar",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "triggers": {
    "crons": ["17 0,5,10,15,20 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ticket-price-radar-db",
      "database_id": "ada5436c-3f5b-43c3-bfe9-cef7386d5558",
      "migrations_dir": "migrations"
    }
  ]
}
